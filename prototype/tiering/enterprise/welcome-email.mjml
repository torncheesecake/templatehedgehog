<!-- DIALECT: ENTERPRISE (prototype/tiering) -->
<!-- Source of truth: src/data/email-examples/library/welcome-email.mjml + getMjmlHead() in src/data/mjml-library.ts -->
<!-- Shared NON-CRITICAL helper styles are externalised to ./head.mjml and pulled in via <mj-include>. -->
<!--                                                                                                       -->
<!-- mjml 5.3.0 include semantics (verified): an included <mj-head> fragment must be a DIRECT CHILD of -->
<!-- <mjml> (not nested inside another <mj-head>, which v5 validation rejects). With ignoreIncludes:false -->
<!-- on the trusted build path the include resolves and its <mj-style> is emitted. We still keep the -->
<!-- GUARDRAIL <mj-style> (responsive + dark-mode) and the brand <mj-raw>/<mj-attributes> tokens INLINE in -->
<!-- the document head: delivery-critical CSS must not depend on include-merge edge cases, and the -->
<!-- inline-token pass (the cross-dialect constant) is what keeps the rendered output robust. -->
<mjml>
  <mj-include path="./head.mjml" />
  <mj-head>
    <mj-preview>Welcome aboard — finish setup and invite your team in two minutes</mj-preview>
    <!-- Guardrail <mj-style> kept INLINE (delivery-critical CSS does not rely on include merge). -->
    <mj-style>
      @media only screen and (max-width:480px) {
        .ios-fix { display: inline-block !important; }
      }
      @media (prefers-color-scheme: dark) {
        .dm-keep-cta td { background-color: #2f67ef !important; }
        .dm-keep-cta a { color: #ffffff !important; }
      }
      [data-ogsc] .dm-keep-cta td { background-color: #2f67ef !important; }
      [data-ogsc] .dm-keep-cta a { color: #ffffff !important; }
    </mj-style>
    <!-- mj-raw meta/font links kept in the main head so delivery-critical tags never depend on include merge. -->
    <mj-raw>
      <meta name="color-scheme" content="light dark" />
      <meta name="supported-color-schemes" content="light dark" />
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
      <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    </mj-raw>
    <mj-attributes>
      <mj-all font-family="'Manrope', 'Inter', Arial, sans-serif" />
      <mj-body width="640px" background-color="#f3f4f6" />
      <mj-wrapper padding="0" full-width="full-width" />
      <mj-section padding="28px 34px" />
      <mj-column padding="0" />
      <mj-image padding="0 0 14px 0" />
      <mj-text padding="0 0 12px 0" font-size="16px" line-height="28px" color="#1a1a1a" />
      <mj-button padding="0" font-size="16px" font-weight="700" border-radius="999px" inner-padding="14px 30px" />

      <mj-class name="h2" font-size="36px" line-height="40px" font-weight="800" />
      <mj-class name="h3" font-size="30px" line-height="34px" font-weight="800" />
      <mj-class name="h4" font-size="26px" line-height="30px" font-weight="800" />
      <mj-class name="body" font-family="'Inter', Arial, sans-serif" font-size="17px" line-height="28px" />
      <mj-class name="small" font-family="'Inter', Arial, sans-serif" font-size="14px" line-height="23px" />
      <mj-class name="label" font-family="'Inter', Arial, sans-serif" font-size="12px" font-weight="700" text-transform="uppercase" letter-spacing="0.12em" />
      <mj-class name="bold" font-weight="700" />
      <mj-class name="extrabold" font-weight="800" />
      <mj-class name="white" color="#ffffff" />
      <mj-class name="light" color="#94a3b8" />
      <mj-class name="dark" color="#1a1a1a" />
      <mj-class name="text-primary" color="#1a1a1a" />
      <mj-class name="text-muted" color="#4a5568" />
      <mj-class name="thblue" color="#2f67ef" />
      <mj-class name="whitebg" background-color="#ffffff" />
      <mj-class name="superlightbg" background-color="#f8fafc" />
      <mj-class name="thbluebg" background-color="#2f67ef" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f3f4f6">
<!-- #-START-# Header -->
<mj-wrapper mj-class="whitebg">
  <mj-section padding="25px 35px">
    <mj-column vertical-align="middle">
      <mj-image src="https://placehold.co/240x80/png?text=TemplateHedgehog+Logo" width="240px" padding="0" align="left" href="https://templatehedgehog.co.uk" alt="TemplateHedgehog" />
    </mj-column>
  </mj-section>
</mj-wrapper>
<!-- #-END-# Header -->

<!-- #-START-# Welcome Email Hero -->
<mj-wrapper mj-class="whitebg">
  <mj-section padding="44px 35px 28px 35px">
    <mj-column width="520px">
      <mj-text mj-class="label thblue" align="center" padding-bottom="12px">Welcome</mj-text>
      <mj-text mj-class="h2 text-primary extrabold" align="center" padding-bottom="12px">Welcome to the product</mj-text>
      <mj-text mj-class="body text-muted" align="center" padding-bottom="22px">Your workspace is ready. Start with the first setup task, then invite the people who need access.</mj-text>
      <mj-button mj-class="thbluebg white body bold" css-class="dm-keep-cta" align="center" border-radius="999px" inner-padding="16px 34px" href="https://templatehedgehog.co.uk">Start setup</mj-button>
    </mj-column>
  </mj-section>
</mj-wrapper>
<!-- #-END-# Welcome Email Hero -->

<!-- #-START-# Onboarding Step Card -->
<mj-wrapper mj-class="whitebg">
  <mj-section>
    <mj-column width="520px">
      <mj-text mj-class="label thblue" align="left" padding-bottom="8px">Onboarding step 2 of 4</mj-text>
      <mj-text mj-class="h4 text-primary extrabold" align="left" padding-bottom="10px">Connect your workspace</mj-text>
      <mj-text mj-class="body text-muted" align="left" padding-bottom="18px">Connect the account your team uses every day so activity, alerts, and handoffs stay in one place.</mj-text>
      <mj-button mj-class="thbluebg white body bold" css-class="dm-keep-cta" align="left" border-radius="999px" inner-padding="14px 28px" href="https://templatehedgehog.co.uk">Connect now</mj-button>
    </mj-column>
  </mj-section>
</mj-wrapper>
<!-- #-END-# Onboarding Step Card -->

<!-- #-START-# app download superlight  -->
<mj-wrapper mj-class="superlightbg">
  <mj-section>
    <mj-column padding-bottom="0">
      <mj-text mj-class="h3 dark" css-class="center">Download the mobile app</mj-text>
    </mj-column>
  </mj-section>
  <mj-section padding-top="0">
    <mj-column>
      <mj-text mj-class="body dark" css-class="center">Keep approvals, account alerts, and time-sensitive updates close by when your team is away from their desk.</mj-text>
    </mj-column>
    <mj-group>
      <mj-column>
        <mj-image src="https://placehold.co/135x40/png?text=App+Store" width="135px" align="left" href="https://templatehedgehog.co.uk" target="_blank" alt="Download on the App Store" />
      </mj-column>
      <mj-column css-class="ios-fix">
        <mj-image src="https://placehold.co/135x40/png?text=Google+Play" width="135px" align="right" href="https://templatehedgehog.co.uk" target="_blank" alt="Get it on Google Play" />
      </mj-column>
    </mj-group>
  </mj-section>
</mj-wrapper>
<!-- #-END-# app download superlight -->

<!-- #-START-# footer onboarding-->
    <mj-wrapper mj-class="whitebg">
      <mj-section padding-top="25px">
        <mj-group>
          <mj-column width="30%" padding="0 0 0 15px">
            <mj-image src="https://placehold.co/240x80/png?text=TemplateHedgehog+Logo" width="55px" height="21px" alt="TemplateHedgehog" align="left" href="https://templatehedgehog.co.uk" target="_blank" />
          </mj-column>
          <mj-column width="70%" padding="0 15px 0 0">
            <mj-text mj-class="small light" align="right" padding-top="3px"><a href="https://templatehedgehog.co.uk" style="color:#999999; text-decoration: underline;">Privacy policy</a> &nbsp;&nbsp;&nbsp;&nbsp;<a href="https://templatehedgehog.co.uk" style="color:#999999; text-decoration: underline;">Manage preferences</a></mj-text>
          </mj-column>
        </mj-group>
      </mj-section>
      <mj-section padding-top="3px">
        <mj-column>
          <mj-divider />
        </mj-column>
      </mj-section>
      <mj-section padding-top="0" padding-bottom="40px">
        <mj-column>
          <mj-text mj-class="small light">Add your sender address to the safe-sender list so future updates arrive cleanly. You're receiving this email because you activated your product's guarantee. If you'd prefer not to receive product support emails, please click <a style="color:#666666; text-decoration:underline;" target="_blank" href="https://templatehedgehog.co.uk/preferences">here</a> to manage your preferences.</mj-text>
          <mj-text mj-class="small light">Use your own legal and compliance copy before production send.</mj-text>
          <mj-text mj-class="small light">TemplateHedgehog Ltd. Example House, London, WC2N 5DU.</mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <!--  #-END-# footer onboarding -->
  </mj-body>
</mjml>
