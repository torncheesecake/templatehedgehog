<!-- Purpose: Thought-leadership email promoting a downloadable guide. -->
<!-- Components: header-brand-row, single-image-left, accent-cta-button, footer-contact-compliance. -->
<!-- Production use: Content-driven nurture email with a gated guide CTA. -->
<mjml>
  <mj-head>
    <mj-preview>The hidden costs of running your reporting on spreadsheets.</mj-preview>
    <mj-attributes>
      <mj-all font-family="'Manrope', 'Inter', Arial, sans-serif" />
      <mj-body width="640px" background-color="#f3f4f6" />
      <mj-wrapper padding="0" full-width="full-width" />
      <mj-section padding="28px 34px" />
      <mj-column padding="0" />
      <mj-image padding="0 0 14px 0" />
      <mj-text padding="0 0 12px 0" font-size="16px" line-height="28px" color="#1a1a1a" />
      <mj-button padding="0" font-size="16px" font-weight="700" border-radius="999px" inner-padding="14px 30px" />
      <mj-class name="h1" font-size="42px" line-height="46px" font-weight="800" />
      <mj-class name="body" font-family="'Inter', Arial, sans-serif" font-size="17px" line-height="28px" />
      <mj-class name="small" font-family="'Inter', Arial, sans-serif" font-size="14px" line-height="23px" />
      <mj-class name="label" font-family="'Inter', Arial, sans-serif" font-size="12px" font-weight="700" text-transform="uppercase" letter-spacing="0.12em" />
      <mj-class name="bold" font-weight="700" />
      <mj-class name="extrabold" font-weight="800" />
      <mj-class name="white" color="#ffffff" />
      <mj-class name="light" color="#94a3b8" />
      <mj-class name="dark" color="#1a1a1a" />
      <mj-class name="text-primary" color="#1a1a1a" />
      <mj-class name="text-muted" color="#4a5568" />
      <mj-class name="thblue" color="#2f67ef" />
      <mj-class name="whitebg" background-color="#ffffff" />
      <mj-class name="superlightbg" background-color="#f8fafc" />
      <mj-class name="thbluebg" background-color="#2f67ef" />
    </mj-attributes>
    <mj-style>
      .border-top-light { border-top: 1px solid rgba(26, 26, 26, 0.1) !important; }
    </mj-style>
    <mj-raw>
      <meta name="color-scheme" content="light dark" />
      <meta name="supported-color-schemes" content="light dark" />
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
      <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    </mj-raw>
  </mj-head>
  <mj-body mj-class="superlightbg">
    <mj-wrapper mj-class="whitebg">
      <mj-section padding="25px 35px">
        <mj-column vertical-align="middle">
          <mj-image src="https://placehold.co/240x80/png?text=Your+Brand+Logo" width="240px" padding="0" align="left" href="https://templatehedgehog.co.uk" alt="Your Brand" />
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-wrapper>
      <mj-section padding="0">
        <mj-column padding="0">
          <mj-image src="https://placehold.co/640x300/png?text=Free+Guide" padding="0" fluid-on-mobile="true" alt="Free reporting guide cover" />
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-wrapper mj-class="superlightbg">
      <mj-section>
        <mj-column>
          <mj-text mj-class="label thblue" align="left" padding-bottom="10px">Free guide</mj-text>
          <mj-text mj-class="h1 text-primary extrabold" align="left" padding-bottom="12px">The hidden cost of spreadsheets</mj-text>
          <mj-text mj-class="body text-muted" align="left">Spreadsheets feel free, but the manual rekeying, version conflicts, and broken formulas quietly add up. Our guide breaks down where that time really goes and what it costs a team over a year.</mj-text>
          <mj-text mj-class="body text-muted" align="left">You will also see a simple framework for deciding which reports are worth moving off spreadsheets first.</mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-wrapper mj-class="superlightbg">
      <mj-section padding-top="0">
        <mj-column>
          <mj-button mj-class="thbluebg white body bold" css-class="dm-keep-cta" align="left" border-radius="999px" inner-padding="15px 30px" href="{{ guide_url }}">Download the guide</mj-button>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-wrapper mj-class="whitebg">
      <mj-section padding-bottom="40px">
        <mj-column>
          <mj-text mj-class="small light" css-class="border-top-light" padding-top="18px">Replace this footer with your own compliance and unsubscribe copy before production send. Manage preferences <a href="https://templatehedgehog.co.uk/preferences" style="color:#94a3b8; text-decoration:underline;">here</a>. Your Brand Ltd. Example House, London, WC2N 5DU.</mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
