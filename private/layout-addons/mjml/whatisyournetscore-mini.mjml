<!-- Purpose: Drive a one-minute self-assessment quiz with a clear single CTA. -->
<!-- Components: header-brand-row, accent-cta-button, footer-contact-compliance. -->
<!-- Production use: Top-of-funnel lead magnet for a scorecard or assessment. -->
<mjml>
  <mj-head>
    <mj-preview>Find out how well you are using your platform in about a minute.</mj-preview>
    <mj-attributes>
      <mj-all font-family="'Manrope', 'Inter', Arial, sans-serif" />
      <mj-body width="640px" background-color="#f3f4f6" />
      <mj-wrapper padding="0" full-width="full-width" />
      <mj-section padding="28px 34px" />
      <mj-column padding="0" />
      <mj-image padding="0 0 14px 0" />
      <mj-text padding="0 0 12px 0" font-size="16px" line-height="28px" color="#1a1a1a" />
      <mj-button padding="0" font-size="16px" font-weight="700" border-radius="999px" inner-padding="14px 30px" />
      <mj-class name="h2" font-size="36px" line-height="40px" font-weight="800" />
      <mj-class name="h4" font-size="26px" line-height="30px" font-weight="800" />
      <mj-class name="h1-display" font-size="56px" line-height="60px" font-weight="800" />
      <mj-class name="body" font-family="'Inter', Arial, sans-serif" font-size="17px" line-height="28px" />
      <mj-class name="small" font-family="'Inter', Arial, sans-serif" font-size="14px" line-height="23px" />
      <mj-class name="label" font-family="'Inter', Arial, sans-serif" font-size="12px" font-weight="700" text-transform="uppercase" letter-spacing="0.12em" />
      <mj-class name="bold" font-weight="700" />
      <mj-class name="extrabold" font-weight="800" />
      <mj-class name="white" color="#ffffff" />
      <mj-class name="light" color="#94a3b8" />
      <mj-class name="dark" color="#1a1a1a" />
      <mj-class name="text-primary" color="#1a1a1a" />
      <mj-class name="text-muted" color="#4a5568" />
      <mj-class name="thblue" color="#2f67ef" />
      <mj-class name="whitebg" background-color="#ffffff" />
      <mj-class name="superlightbg" background-color="#f8fafc" />
      <mj-class name="thbluebg" background-color="#2f67ef" />
    </mj-attributes>
    <mj-style>
      .border-top-light { border-top: 1px solid rgba(26, 26, 26, 0.1) !important; }
    </mj-style>
    <mj-raw>
      <meta name="color-scheme" content="light dark" />
      <meta name="supported-color-schemes" content="light dark" />
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
      <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    </mj-raw>
  </mj-head>
  <mj-body mj-class="superlightbg">
    <mj-wrapper mj-class="whitebg">
      <mj-section padding="25px 35px">
        <mj-column vertical-align="middle">
          <mj-image src="https://placehold.co/240x80/png?text=Your+Brand+Logo" width="240px" padding="0" align="left" href="https://templatehedgehog.co.uk" alt="Your Brand" />
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-wrapper mj-class="superlightbg">
      <mj-section>
        <mj-column>
          <mj-text mj-class="label thblue" align="left" padding-bottom="12px">One-minute scorecard</mj-text>
          <mj-text mj-class="h1-display text-primary extrabold" align="left" padding-bottom="20px">What is your score?</mj-text>
          <mj-text mj-class="body text-muted" align="left">Answer eight quick questions and get an instant read on how much value you are getting from your platform today, with a short list of the gaps worth closing first.</mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-wrapper mj-class="whitebg">
      <mj-section padding-top="0">
        <mj-column>
          <mj-text mj-class="h2 text-primary extrabold" align="left">No login, no long form</mj-text>
          <mj-text mj-class="body text-muted" align="left">The quiz is anonymous and takes about a minute. You will see your result on screen straight away, along with the two or three changes that usually move the needle most.</mj-text>
        </mj-column>
      </mj-section>
      <mj-section padding-top="0">
        <mj-column>
          <mj-text mj-class="h4 text-primary extrabold" align="center" padding-bottom="18px">Ready when you are, {{ first_name }}</mj-text>
          <mj-button mj-class="thbluebg white body bold" css-class="dm-keep-cta" align="center" border-radius="999px" inner-padding="16px 34px" href="{{ quiz_url }}">Start the quiz</mj-button>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-wrapper mj-class="superlightbg">
      <mj-section padding-bottom="40px">
        <mj-column>
          <mj-text mj-class="h2 text-primary extrabold" align="left">What you get back</mj-text>
          <mj-text mj-class="body text-muted" align="left">A clear score, a benchmark against teams like yours, and a short, practical plan you can act on the same week. No sales call required to see your result.</mj-text>
          <mj-text mj-class="small light" css-class="border-top-light" padding-top="18px">You are receiving this because you asked about your platform from Your Brand. Replace this footer with your own compliance copy before production send. Manage preferences <a href="https://templatehedgehog.co.uk/preferences" style="color:#94a3b8; text-decoration:underline;">here</a>. Your Brand Ltd. Example House, London, WC2N 5DU.</mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
