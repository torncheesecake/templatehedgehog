<!-- Purpose: Help a charity see quick wins from the product in a one-minute read. -->
<!-- Components: header-brand-row, accent-cta-button, footer-contact-compliance. -->
<!-- Production use: Lightweight nurture email to charity and non-profit prospects. -->
<mjml>
  <mj-head>
    <mj-preview>See how your charity can do more with the time and budget you already have.</mj-preview>
    <mj-attributes>
      <mj-all font-family="'Manrope', 'Inter', Arial, sans-serif" />
      <mj-body width="640px" background-color="#f3f4f6" />
      <mj-wrapper padding="0" full-width="full-width" />
      <mj-section padding="28px 34px" />
      <mj-column padding="0" />
      <mj-image padding="0 0 14px 0" />
      <mj-text padding="0 0 12px 0" font-size="16px" line-height="28px" color="#1a1a1a" />
      <mj-button padding="0" font-size="16px" font-weight="700" border-radius="999px" inner-padding="14px 30px" />
      <mj-class name="h2" font-size="36px" line-height="40px" font-weight="800" />
      <mj-class name="h3" font-size="30px" line-height="34px" font-weight="800" />
      <mj-class name="body" font-family="'Inter', Arial, sans-serif" font-size="17px" line-height="28px" />
      <mj-class name="small" font-family="'Inter', Arial, sans-serif" font-size="14px" line-height="23px" />
      <mj-class name="label" font-family="'Inter', Arial, sans-serif" font-size="12px" font-weight="700" text-transform="uppercase" letter-spacing="0.12em" />
      <mj-class name="bold" font-weight="700" />
      <mj-class name="extrabold" font-weight="800" />
      <mj-class name="white" color="#ffffff" />
      <mj-class name="light" color="#94a3b8" />
      <mj-class name="dark" color="#1a1a1a" />
      <mj-class name="text-primary" color="#1a1a1a" />
      <mj-class name="text-muted" color="#4a5568" />
      <mj-class name="thblue" color="#2f67ef" />
      <mj-class name="whitebg" background-color="#ffffff" />
      <mj-class name="superlightbg" background-color="#f8fafc" />
      <mj-class name="thbluebg" background-color="#2f67ef" />
    </mj-attributes>
    <mj-style>
      .border-top-light { border-top: 1px solid rgba(26, 26, 26, 0.1) !important; }
    </mj-style>
    <mj-raw>
      <meta name="color-scheme" content="light dark" />
      <meta name="supported-color-schemes" content="light dark" />
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
      <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    </mj-raw>
  </mj-head>
  <mj-body mj-class="superlightbg">
    <mj-wrapper mj-class="whitebg">
      <mj-section padding="25px 35px">
        <mj-column vertical-align="middle">
          <mj-image src="https://placehold.co/240x80/png?text=Your+Brand+Logo" width="240px" padding="0" align="left" href="https://templatehedgehog.co.uk" alt="Your Brand" />
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-wrapper mj-class="superlightbg">
      <mj-section>
        <mj-column>
          <mj-text mj-class="label thblue" align="left" padding-bottom="10px">Charity insight</mj-text>
          <mj-text mj-class="h3 text-primary extrabold" align="left" padding-bottom="12px">Hello {{ first_name }}, free up more time for your cause</mj-text>
          <mj-text mj-class="body text-muted" align="left">Most charity teams lose hours every week to manual reporting and reconciliation. A connected workspace pulls grants, donations, and spend into one place so your trustees see the full picture without the spreadsheet chase.</mj-text>
          <mj-text mj-class="body text-muted" align="left">Here is a one-minute read on the three changes that make the biggest difference for finance teams running lean.</mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-wrapper mj-class="whitebg">
      <mj-section padding-top="0">
        <mj-column>
          <mj-text mj-class="body text-muted" align="left">Start with the area that costs you the most time today, then add the rest once your team is comfortable. Every step is reversible, so there is no risk to your existing process.</mj-text>
          <mj-button mj-class="thbluebg white body bold" css-class="dm-keep-cta" align="left" border-radius="999px" inner-padding="15px 30px" href="{{ guide_url }}">Read the guide</mj-button>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-wrapper mj-class="whitebg">
      <mj-section padding-top="0" padding-bottom="40px">
        <mj-column>
          <mj-text mj-class="small light" css-class="border-top-light" padding-top="18px">You are receiving this because you asked about non-profit resources from Your Brand. Replace this footer with your own legal, contact, and unsubscribe copy before production send. Manage your preferences <a href="https://templatehedgehog.co.uk/preferences" style="color:#94a3b8; text-decoration:underline;">here</a>.</mj-text>
          <mj-text mj-class="small light">Your Brand Ltd. Example House, London, WC2N 5DU.</mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
