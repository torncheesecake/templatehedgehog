<!-- #-START-# Logo Trust Strip -->
<mj-wrapper mj-class="whitebg">
  <mj-section padding-bottom="18px">
    <mj-column>
      <mj-text mj-class="h5 text-primary extrabold" align="center" padding-bottom="8px">
        Add real customer or partner logos here
      </mj-text>
      <mj-text mj-class="small text-muted" align="center" padding-bottom="0">
        Replace these placeholders only when you have permission to show the marks.
      </mj-text>
    </mj-column>
  </mj-section>

  <mj-section padding-top="0" padding-bottom="8px">
    <mj-column width="25%" padding="8px"><mj-image src="https://dummyimage.com/180x64/f3f4f6/6b7280&text=Logo+01" alt="Placeholder logo 01" width="130px" /></mj-column>
    <mj-column width="25%" padding="8px"><mj-image src="https://dummyimage.com/180x64/f3f4f6/6b7280&text=Logo+02" alt="Placeholder logo 02" width="130px" /></mj-column>
    <mj-column width="25%" padding="8px"><mj-image src="https://dummyimage.com/180x64/f3f4f6/6b7280&text=Logo+03" alt="Placeholder logo 03" width="130px" /></mj-column>
    <mj-column width="25%" padding="8px"><mj-image src="https://dummyimage.com/180x64/f3f4f6/6b7280&text=Logo+04" alt="Placeholder logo 04" width="130px" /></mj-column>
  </mj-section>
</mj-wrapper>
<!-- #-END-# Logo Trust Strip -->
