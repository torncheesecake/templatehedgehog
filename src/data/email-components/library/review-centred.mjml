<!-- #-START-# review centred -->
<mj-wrapper mj-class="whitebg">
  <mj-section>
    <mj-column>
      <mj-image src="https://placehold.co/208x30/png?text=Rating+placeholder" width="200px" align="center" padding="20px 0" />
      <mj-text mj-class="h2 dark" align="center">"Add a real approved review here."</mj-text>
      <mj-text mj-class="body medium" align="center">Reviewer name</mj-text>
      <mj-text mj-class="small light" align="center">
        Replace this content only when the review and rating are approved for use.
      </mj-text>
      <!-- #-START-# Centred CTA -->
      <mj-social font-size="14px" icon-size="30px" mode="horizontal" align="center">
        <mj-social-element src="https://placehold.co/640x360/png?text=TemplateHedgehog+Visual" name="cta" href="https://templatehedgehog.co.uk" target="_blank" mj-class="dark">
          Write a review
        </mj-social-element>
      </mj-social>
      <!-- #-END-# Centred CTA -->
    </mj-column>
  </mj-section>
</mj-wrapper>
<!-- #-END-# review centred -->
